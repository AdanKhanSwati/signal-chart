{
  "name": "signal-chart",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "../.cloudflare-dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/"
    ],
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "observability": {
    "enabled": false
  },
  "keep_vars": true,
  "triggers": {
    "crons": [
      "7,8,9,10 * * * *"
    ]
  },
  "vars": {
    "SC_AUTO_RESEARCH_ENABLED": "true",
    "SC_AUTO_PUBLISH_ENABLED": "false"
  }
}
