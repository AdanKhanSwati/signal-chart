{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/signals.js": {
      "maxDuration": 60
    },
    "api/research.js": {
      "maxDuration": 60
    },
    "api/auto-signals.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/markets",
      "destination": "/api/candles?action=markets"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "signalchart-recovery-staging": false
    }
  }
}
