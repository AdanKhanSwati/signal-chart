# SignalChart configuration template only — NEVER commit real keys.
# Existing authentication (publishable client credentials)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Trial backend: choose SUPABASE_SECRET_KEY (new) OR legacy JWT service role key.
# Both are elevated Supabase credentials, backend only.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# At least 32 random secret characters; retain secure backup for phone claim history.
SC_TRIAL_HMAC_SECRET=

# Historical account cutover, set ONLY after inspecting/importing preexisting trial use.
SC_TRIAL_ROLLOUT_AT=

# Existing app/admin settings — these must remain server-side.
CANDRIVA_ADMIN_EMAIL=
BLOB_READ_WRITE_TOKEN=

# Keep real financial operations disabled during development.
CANDRIVA_PAYMENTS_ENABLED=false

# Trading signals must not be marketed as verified until backend source/data QA passes.
CANDRIVA_SIGNALS_ENABLED=false

# SMS provider is configured separately in Supabase Auth settings.
# Do not enable paid SMS delivery without explicit owner approval.

# WhatsApp phone_change OTP. NO provider call occurs until this is explicitly true.
# Do not set true before configuring a Twilio/Twilio Verify WhatsApp sender,
# testing phone change, and approving per-message costs.
SC_TRIAL_PHONE_DELIVERY_ENABLED=false
